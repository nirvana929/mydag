digraph G {
    // 环1：三角环
    v1 -> v2;
    v2 -> v3;
    v3 -> v1;

    // 环2：五节点环
    v4 -> v5;
    v5 -> v6;
    v6 -> v7;
    v7 -> v8;
    v8 -> v4;

    // 环3：小双环
    v9 -> v10;
    v10 -> v9;

    // 环4：大环 + 分支
    v11 -> v12;
    v12 -> v13;
    v13 -> v14;
    v14 -> v15;
    v15 -> v11; // 回到 v11，形成环

    // 从环4 引出链
    v13 -> v16;
    v16 -> v17;
    v17 -> v18;

    // 链末尾返回，形成新环
    v18 -> v13;

    // 链结构 (单向)
    v19 -> v20;
    v20 -> v21;
    v21 -> v22;

    // 汇合结构
    v22 -> v23;
    v18 -> v23;
    v8  -> v23;

    // 从 v23 分叉
    v23 -> v24;
    v23 -> v25;

    // v24 分叉出一个小环
    v24 -> v26;
    v26 -> v24;

    // v25 指向链尾
    v25 -> v27;
    v27 -> v28;
    v28 -> v29;
    v29 -> v30;

    // 交叉边，制造复杂性
    v6 -> v10;
    v15 -> v5;
    v20 -> v7;
    v30 -> v1;
}
