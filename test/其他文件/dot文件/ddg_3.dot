digraph G {
    rankdir=LR;  // 从左到右布局
    node [shape=circle, style=filled, fillcolor=lightblue];  // 节点样式

    // 主线程到分线程
    "Main/Start" -> "Main/End";

    "Thread1/1_1" -> "Thread1/1_2";
    "Thread1/1_2" -> "Thread1/1_3";
    "Thread1/1_3" -> "Thread1/1_4";
    "Thread2/2_1" -> "Thread2/2_2";
    "Thread2/2_2" -> "Thread2/2_3";
    "Thread2/2_3" -> "Thread2/2_4";
    "Thread3/3_1" -> "Thread3/3_2";
    "Thread3/3_2" -> "Thread3/3_3";
    "Thread3/3_3" -> "Thread3/3_4";

    // 分线程的边
    "Main/End" -> "Thread1/1_1";
    "Main/End" -> "Thread2/2_1";
    "Main/End" -> "Thread3/3_1";

    // 交叉依赖关系
    "Thread1/1_3" -> "Thread2/2_1";
    "Thread2/2_3" -> "Thread3/3_1";
    "Thread3/3_3" -> "Thread1/1_1";
}
