digraph G {
    rankdir=LR;  // 从左到右布局
    node [shape=circle, style=filled, fillcolor=lightblue];  // 节点样式

    // 主线程到分线程
    main_start [label="Main Start"];
    main_end [label="Main End"];

    thread_1_1 [label="Thread1 / 1_1"];
    thread_1_2 [label="Thread1 / 1_2"];
    thread_1_3 [label="Thread1 / 1_3"];
    thread_1_4 [label="Thread1 / 1_4"];
    thread_2_1 [label="Thread2 / 2_1"];
    thread_2_2 [label="Thread2 / 2_2"];
    thread_2_3 [label="Thread2 / 2_3"];
    thread_2_4 [label="Thread2 / 2_4"];
    thread_3_1 [label="Thread3 / 3_1"];
    thread_3_2 [label="Thread3 / 3_2"];
    thread_3_3 [label="Thread3 / 3_3"];
    thread_3_4 [label="Thread3 / 3_4"];

    // 分线程的边
    main_start -> main_end;
    main_end -> thread_1_1;
    main_end -> thread_2_1;
    main_end -> thread_3_1;

    thread_1_1 -> thread_1_2;
    thread_1_2 -> thread_1_3;
    thread_1_3 -> thread_1_4;
    thread_2_1 -> thread_2_2;
    thread_2_2 -> thread_2_3;
    thread_2_3 -> thread_2_4;
    thread_3_1 -> thread_3_2;
    thread_3_2 -> thread_3_3;
    thread_3_3 -> thread_3_4;

    // 交叉依赖关系
    thread_1_3 -> thread_2_1;
    thread_2_3 -> thread_3_1;
    thread_3_3 -> thread_1_1;
}
